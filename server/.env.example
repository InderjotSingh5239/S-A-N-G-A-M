# SANGAM Backend Environment Variables
#
# Set these in Replit's Secrets tool (NOT in this file for production):
#   MONGODB_URI = your MongoDB connection string
#   PORT = 3001 (optional, defaults to 3001)
#
# For local development, you can create a .env file in the /server directory.

MONGODB_URI=replace_with_your_mongodb_uri_in_replit_secrets
PORT=3001
